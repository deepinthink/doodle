      <groupId>org.deepinthink.doodle</groupId>
      <artifactId>spring-game-starter-service-payment-admin-vaadin</artifactId>
    </dependency>
    <dependency>
      <groupId>org.deepinthink.doodle</groupId>
      <artifactId>spring-game-starter-service-role-admin-vaadin</artifactId>
    </dependency>
    <dependency>
      <groupId>com.vaadin</groupId>
      <artifactId>vaadin-dev</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
